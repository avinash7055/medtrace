# ─────────────────────────────────────────────────────────
# MedTrace — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── Google Gemini (REQUIRED) ──────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=models/embedding-001

# ── Google Cloud (Optional) ───────────────────────────────
# Only needed if deploying to GCP
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# ── Arize Phoenix — Self-Hosted (No API key required) ─────
# Phoenix runs inside Docker — no external account needed
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=medtrace-agent

# ── ChromaDB Vector Store ─────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=medical_knowledge

# ── Evolution Engine ──────────────────────────────────────
# Agent triggers self-improvement when avg score drops below this
EVOLUTION_SCORE_THRESHOLD=6.5
EVOLUTION_MIN_FAILURES=5

# ── FastAPI Server ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
